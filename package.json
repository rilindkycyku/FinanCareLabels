{
  "name": "financare-labels",
  "version": "1.0.1",
  "description": "FinanCare Labels - çmimorja e rafteve nga Excel-i, pa internet (portable)",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "author": "Rilind Kyçyku",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "electron:dev": "vite build && electron .",
    "dist": "vite build && node scripts/nisesi-portabel.mjs && electron-builder --win nsis portable",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "bootstrap": "^5.3.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "flag-icons": "^7.6.0",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.2",
    "react-dom": "^18.2.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.rilindkycyku.financarelabels",
    "productName": "FinanCare Labels",
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "electronLanguages": [
      "en-US"
    ],
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}",
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FinanCare Labels",
      "runAfterFinish": true,
      "installerLanguages": [
        "sq_AL",
        "en_US"
      ],
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  }
}
